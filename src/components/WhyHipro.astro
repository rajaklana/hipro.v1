---
const services = [
  { 
    title: 'Design', 
    desc: 'Crafting strong visual identities and strategic brand assets that communicate with clarity and purpose.',
    icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z'
  },
  { 
    title: 'Video', 
    desc: 'Telling authentic stories with emotion and depth, creating cinematic experiences that make audiences feel, connect, and remember.',
    icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z'
  },
  { 
    title: 'Animation', 
    desc: 'Turning complex ideas into engaging and dynamic visual narratives.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z'
  },
  { 
    title: '3D Vizualitation', 
    desc: 'Bringing concepts to life through immersive and realistic visual representations.',
    icon: 'M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z'
  }
];
---
<section class="py-24 relative">
  <div class="container space-y-16">
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      <div class="space-y-4">
        <h2 class="text-3xl font-black text-[#1a365d]">Why HIProduction?</h2>
        <p class="text-gray-500 font-medium max-w-2xl text-sm md:text-base">
          we go beyond production—we transform ideas into meaningful visual stories. With integrated creative expertise and strong execution, we deliver impactful, original, and purpose-driven solutions for every brand we work with.
        </p>
      </div>
      
      <div class="relative group cursor-pointer lg:mr-20">
        <div class="absolute -top-4 -right-4 bg-red-500 text-white text-[10px] font-black px-3 py-1 rounded-full shadow-lg z-10 animate-pulse">
          FREE Consultation
        </div>
        <img 
          src="/assets/images/hippo-happy.png" 
          alt="Hippo Consultation" 
          class="w-32 h-auto drop-shadow-xl group-hover:scale-110 transition-transform duration-300"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {services.map((service) => (
        <div class="space-y-6 group">
          <div class="w-16 h-16 flex items-center justify-center text-gray-400 group-hover:text-[#2b6cb0] transition-colors border-2 border-transparent group-hover:border-[#2b6cb0] rounded-xl p-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
            </svg>
          </div>
          <div class="space-y-3">
             <div class="inline-block bg-[#1a365d] text-white text-xs font-black px-4 py-1.5 rounded-sm uppercase tracking-widest">
                {service.title}
             </div>
             <p class="text-[13px] text-gray-500 font-medium leading-relaxed">
               {service.desc}
             </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
