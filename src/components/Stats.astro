---
---
<section class="py-20 border-b border-gray-100 relative overflow-hidden bg-gray-50/30">
  <div class="container grid md:grid-cols-2 gap-12 items-center">
    <div class="space-y-10">
      <div class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-black text-[#1a365d] leading-snug">
          Trusted by clients who believe in our journey<br/>
          and empower us to keep moving forward.
        </h2>
        <p class="text-sm md:text-base text-[#4a5568] font-medium leading-relaxed">
          Their trust is not only a recognition of our work, but also a driving force that pushes us to grow, innovate, and continuously deliver creative solutions with greater purpose and impact.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-10">
        <div class="flex items-center gap-4">
          <span class="text-5xl md:text-6xl font-black font-product-sans text-[#1a365d]">10<span class="text-red-500 font-product-sans">+</span></span>
          <p class="text-[10px] font-black leading-tight uppercase text-gray-400">Years of<br/>Experience</p>
        </div>
        
        <div class="w-[3px] h-12 bg-red-600 rounded-full"></div>

        <div class="flex items-center gap-4">
          <span class="text-5xl md:text-6xl font-black font-product-sans text-[#1a365d]">100<span class="text-red-500 font-product-sans">+</span></span>
          <p class="text-[10px] font-black leading-tight uppercase text-gray-400">Client</p>
        </div>

        <div class="w-[3px] h-12 bg-red-600 rounded-full hidden sm:block"></div>

        <div class="flex items-center gap-4">
          <span class="text-5xl md:text-6xl font-black font-product-sans text-[#1a365d]">20<span class="text-red-500 font-product-sans">+</span></span>
          <p class="text-[10px] font-black leading-tight uppercase text-gray-400">Creative<br/>People</p>
        </div>
      </div>
    </div>

    <div class="flex justify-end pr-8">
      <img 
        src="/src/assets/images/red-character.png" 
        alt="Excited Character" 
        class="w-full max-w-sm drop-shadow-2xl hover:scale-110 transition-transform duration-500"
      />
    </div>
  </div>
</section>
