---
---
<footer class="bg-[#1a1a1a] text-white py-24 relative overflow-hidden">
  <div class="container grid md:grid-cols-2 gap-16">
    <div class="space-y-12 z-10">
      <h2 class="text-5xl font-black tracking-tighter decoration-[#2b6cb0] underline decoration-[8px] underline-offset-8">
        Hiproduction x face
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-6">
          <h3 class="text-xl font-black text-white">Head Office, Surabaya</h3>
          <p class="text-gray-400 text-sm leading-relaxed font-medium">
            JL. Gayungsari 1 no 47. Gayungan.<br/>
            Kecamatan Gayungan, Surabaya, Jawa Timur.
          </p>
        </div>

        <div class="space-y-6">
          <h3 class="text-xl font-black text-white">Branch Office, Sidoarjo</h3>
          <p class="text-gray-400 text-sm leading-relaxed font-medium">
            Griya Permata Gedangan, Blok K4-08<br/>
            Kecamatan Gedangan, Sidoarjo, Jawa Timur.
          </p>
        </div>
      </div>

      <div class="space-y-3">
        <h3 class="text-2xl font-black text-white">Email</h3>
        <p class="text-[#2b6cb0] text-lg font-black hover:underline cursor-pointer transition-all">hiproject@gmail.com</p>
      </div>
    </div>

    <div class="relative flex justify-end items-end">
       <!-- Large faded background mascot as per image -->
       <div class="absolute -bottom-24 -right-24 w-[500px] opacity-10 pointer-events-none">
         <svg viewBox="0 0 200 200" class="fill-white">
            <path d="M100 20 C60 20 20 60 20 100 C20 140 60 180 100 180 C140 180 180 140 180 100 C180 60 140 20 100 20 Z" />
         </svg>
       </div>

       <!-- Chibi interaction with Question bubble -->
       <div class="relative group cursor-pointer">
         <div class="absolute -top-16 -right-6 bg-red-600 text-white text-[12px] font-black px-5 py-2.5 rounded-2xl rounded-bl-none shadow-2xl rotate-6 transition-transform group-hover:scale-125 group-hover:-translate-y-4 group-hover:rotate-12">
           QUESTION?
         </div>
         <img 
            src="/src/assets/images/footer-mascot.png" 
            alt="Footer Mascot" 
            class="w-80 h-auto drop-shadow-2xl group-hover:scale-105 transition-transform duration-500"
         />
       </div>
    </div>
  </div>
</footer>
