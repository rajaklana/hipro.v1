---
---
<section class="relative pt-12 pb-24 overflow-hidden">
  <div class="container grid md:grid-cols-2 gap-8 items-center">
    <div class="space-y-8 z-10">
      <div class="space-y-4">
        <h1 class="text-5xl md:text-6xl font-black tracking-tight leading-[1.05] text-[#1a1a1a]">
          One Stop Creative<br/>Solution Company
        </h1>
        <p class="text-base md:text-lg text-[#4a5568] font-medium leading-relaxed">
          Turn complexity into clarity with engaging <span class="text-[#2b6cb0] font-bold italic">Creative Production.</span>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <a href="#info" class="bg-[#1e4a8e] text-white px-8 py-3.5 rounded-full font-black text-lg transition-all hover:bg-[#153a6f] shadow-xl hover:shadow-2xl hover:-translate-y-1">
          Get More Info
        </a>
        
        <div class="flex items-center gap-6 text-[#4a5568] font-black">
          <button class="flex items-center gap-2 hover:text-black transition-colors group">
            Hipro Creative
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 group-hover:text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <button class="flex items-center gap-2 hover:text-black transition-colors group">
            Face Documentary
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 group-hover:text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="relative flex justify-center">
      <img 
        src="/assets/images/hippo-globe.png" 
        alt="Hippo on Globe" 
        class="relative w-full max-w-lg drop-shadow-2xl"
      />
    </div>
  </div>

</section>
