---
const team = [
  { name: 'Vanverr', role: 'Character Illustrator', img: '/assets/images/team-1.png' },
  { name: 'Dimas Ilham', role: 'Music Composer', img: '/assets/images/team-2.png' },
  { name: 'Fajar Motion', role: 'Animator', img: '/assets/images/team-3.png' },
  { name: 'Danddy Danu', role: 'Ilustrator', img: '/assets/images/team-1.png' },
  { name: 'Aisyah Denti', role: 'Script Writer', img: '/assets/images/team-2.png' },
  { name: 'Hafidz Bachtiar', role: 'Ilustrator', img: '/assets/images/team-3.png' },
];
---
<section class="py-24 bg-[#1a1a1a] text-white overflow-hidden">
  <div class="container space-y-16">
    <div class="text-center space-y-3">
      <h2 class="text-3xl font-black tracking-tight">Meet Our Team</h2>
      <p class="text-[10px] font-black uppercase tracking-[0.3em] text-[#2b6cb0]">Creative People</p>
    </div>

    <div class="flex flex-wrap justify-center gap-y-12 gap-x-12">
      {team.map((member) => (
        <div class="flex flex-col items-center gap-6 group cursor-pointer w-40">
          <div class="w-32 h-32 rounded-full overflow-hidden p-1 bg-white/10 group-hover:bg-[#2b6cb0] transition-colors duration-500">
            <img 
              src={member.img} 
              alt={member.name} 
              class="w-full h-full object-cover rounded-full"
            />
          </div>
          <div class="text-center space-y-1">
            <h3 class="font-black text-base leading-none tracking-tight">{member.name}</h3>
            <p class="text-[9px] font-black uppercase text-gray-400 tracking-widest">{member.role}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="flex justify-center gap-3 pt-8">
      {Array.from({ length: 5 }).map((_, i) => (
        <div class={`w-2.5 h-2.5 rounded-full transition-all duration-300 ${i === 2 ? 'bg-white scale-110' : 'bg-gray-600'}`}></div>
      ))}
    </div>
  </div>
</section>
