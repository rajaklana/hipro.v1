---
const clientsRow1 = Array(5).fill({ name: 'NUSANTARA' });
const clientsRow2 = Array(4).fill({ name: 'NUSANTARA' });
---
<section class="py-20 bg-[#1a1a1a] text-white">
  <div class="container text-center space-y-16">
    <h2 class="text-4xl font-black tracking-tight">Our Client</h2>
    
    <div class="space-y-12">
      <!-- Row 1: 5 Clients -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-y-12 gap-x-8">
        {clientsRow1.map((client) => (
          <div class="flex flex-col items-center gap-3 group cursor-pointer">
            <div class="w-16 h-16 relative opacity-60 group-hover:opacity-100 transition-all duration-300 group-hover:scale-110">
              <svg viewBox="0 0 100 100" class="fill-white">
                 <path d="M50 5 L65 40 L95 40 L70 60 L80 95 L50 75 L20 95 L30 60 L5 40 L35 40 Z" />
                 <circle cx="50" cy="50" r="10" fill="none" stroke="white" stroke-width="2" />
              </svg>
            </div>
            <p class="text-[10px] font-black tracking-[0.3em] text-gray-400 group-hover:text-white transition-colors uppercase">{client.name}</p>
          </div>
        ))}
      </div>

      <!-- Row 2: 4 Clients (Centered) -->
      <div class="flex flex-wrap justify-center gap-y-12 gap-x-12 md:gap-x-24">
        {clientsRow2.map((client) => (
          <div class="flex flex-col items-center gap-3 group cursor-pointer w-32">
            <div class="w-16 h-16 relative opacity-60 group-hover:opacity-100 transition-all duration-300 group-hover:scale-110">
              <svg viewBox="0 0 100 100" class="fill-white">
                 <path d="M50 5 L65 40 L95 40 L70 60 L80 95 L50 75 L20 95 L30 60 L5 40 L35 40 Z" />
                 <circle cx="50" cy="50" r="10" fill="none" stroke="white" stroke-width="2" />
              </svg>
            </div>
            <p class="text-[10px] font-black tracking-[0.3em] text-gray-400 group-hover:text-white transition-colors uppercase">{client.name}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
